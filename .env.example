# ──────────────────────────────────────────────
# IronTrack — Environment Variables
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ─── Database (PostgreSQL) ────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irontrack?schema=public

# ─── JWT / Auth ───────────────────────────────
JWT_SECRET=change-me-to-a-strong-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-another-strong-random-string
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ─────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ─── API Server ───────────────────────────────
API_PORT=3000
API_PREFIX=api
NODE_ENV=development

# ─── ML Service (FastAPI) ─────────────────────
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_PORT=8000

# ─── Web App (React / Vite) ──────────────────
VITE_API_URL=http://localhost:3000/api

# ─── Mobile App (Expo) ───────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api

# ─── Docker ───────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=irontrack
POSTGRES_PORT=5432

# ─── Redis (optional, not used in MVP) ───────
# REDIS_URL=redis://localhost:6379
