# IronTrack Environment Variables
# Copy this file to .env and update values as needed.

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/irontrack?schema=public

# API
NODE_ENV=development
API_PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# JWT
JWT_ACCESS_SECRET=change-me-to-a-strong-random-string
JWT_REFRESH_SECRET=change-me-another-strong-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# ML service
ML_SERVICE_URL=http://localhost:5000
ML_SERVICE_PORT=5000

# Web
VITE_API_URL=http://localhost:3000/api/v1

# Mobile
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Docker / Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=irontrack
POSTGRES_PORT=5432
