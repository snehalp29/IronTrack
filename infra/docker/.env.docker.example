# Example Docker environment configuration.
# This file is intended as a template only.
# Do NOT put real secrets here; use an untracked `.env.docker` file locally.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD
POSTGRES_DB=irontrack
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:REPLACE_ME_POSTGRES_PASSWORD@postgres:5432/irontrack?schema=public
# Linux Docker can now resolve host.docker.internal via compose extra_hosts.
ML_SERVICE_URL=http://host.docker.internal:5000
API_PORT=3000
API_PREFIX=api/v1
JWT_ACCESS_SECRET=REPLACE_ME_JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=REPLACE_ME_JWT_REFRESH_SECRET
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
GOOGLE_CLIENT_ID=REPLACE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_ME_GOOGLE_CLIENT_SECRET
# Local development example only. Use an https callback URL for production.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
DOCKER_VITE_API_URL=http://localhost:3000/api/v1
