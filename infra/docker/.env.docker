POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=irontrack
POSTGRES_PORT=5432

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/irontrack?schema=public
ML_SERVICE_URL=http://host.docker.internal:5000
API_PORT=4000
API_PREFIX=api/v1
JWT_ACCESS_SECRET=change-access-secret-in-docker
JWT_REFRESH_SECRET=change-refresh-secret-in-docker
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
GOOGLE_CLIENT_ID=docker-local-google-client-id
GOOGLE_CLIENT_SECRET=docker-local-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback
DOCKER_VITE_API_URL=http://localhost:4000/api/v1
