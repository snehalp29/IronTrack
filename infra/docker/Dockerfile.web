ARG NODE_VERSION=24

FROM node:${NODE_VERSION}-bookworm-slim AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json
COPY libs/shared/package.json libs/shared/package.json
RUN corepack enable && pnpm install --frozen-lockfile --filter @irontrack/web...
COPY . .
RUN pnpm --filter @irontrack/web build

FROM nginx:1.29-alpine
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY infra/docker/runtime-env.js.template /usr/share/nginx/html/runtime-env.js.template
COPY infra/docker/40-runtime-env.sh /docker-entrypoint.d/40-runtime-env.sh
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-runtime-env.sh
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=5s --retries=5 CMD wget -qO- http://localhost:80 || exit 1
