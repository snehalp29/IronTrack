{
  "name": "@irontrack/source",
  "version": "0.1.0",
  "private": true,
  "description": "IronTrack - Production-ready workout tracking monorepo",
  "license": "MIT",
  "scripts": {
    "build": "pnpm run build:api && pnpm run build:web",
    "build:api": "pnpm --filter @irontrack/api build",
    "build:web": "pnpm --filter @irontrack/web build",
    "db:generate": "pnpm --filter @irontrack/api exec prisma generate",
    "db:migrate": "pnpm --filter @irontrack/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @irontrack/api exec prisma db seed",
    "db:seed:demo": "pnpm --filter @irontrack/api prisma:seed:demo",
    "db:studio": "pnpm --filter @irontrack/api exec prisma studio",
    "docker:down": "NODE_VERSION=$(cat .nvmrc) docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "docker:up": "NODE_VERSION=$(cat .nvmrc) docker compose --env-file .env -f infra/docker/docker-compose.yml up -d --build",
    "docker:validate": "bash tools/scripts/validate-docker.sh",
    "docker:wait": "node ./tools/scripts/wait-for-services.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:code && pnpm run format:check && pnpm run test",
    "lint:code": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings 0",
    "lint:fix": "pnpm run lint:code -- --fix && pnpm run format",
    "prepare": "husky",
    "serve:api": "pnpm --filter @irontrack/api dev",
    "serve:web": "pnpm --filter @irontrack/web dev",
    "setup": "pnpm install && pnpm db:generate",
    "test": "pnpm run test:api && pnpm run test:web && pnpm run test:shared",
    "test:api": "pnpm --filter @irontrack/api test",
    "test:e2e:api": "pnpm --filter @irontrack/api test:e2e",
    "test:e2e:api:docker": "pnpm --filter @irontrack/api test:e2e:docker",
    "test:e2e:docker": "pnpm docker:up && pnpm docker:wait && pnpm run test:e2e:api:docker && pnpm run test:e2e:web:docker",
    "test:e2e:web": "pnpm --filter @irontrack/web test:e2e",
    "test:e2e:web:docker": "E2E_TARGET=docker pnpm --filter @irontrack/web test:e2e",
    "test:e2e:web:headless": "PW_HEADLESS=1 pnpm --filter @irontrack/web test:e2e",
    "test:shared": "pnpm --filter @irontrack/shared test",
    "test:web": "pnpm --filter @irontrack/web test",
    "typecheck": "pnpm run typecheck:api && pnpm run typecheck:web && pnpm run typecheck:shared",
    "typecheck:api": "pnpm --filter @irontrack/api run typecheck",
    "typecheck:shared": "pnpm --filter @irontrack/shared run typecheck",
    "typecheck:web": "pnpm --filter @irontrack/web run typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/js": "22.5.3",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.0",
    "nx": "22.5.3",
    "prettier": "~3.6.2",
    "prettier-plugin-organize-attributes": "^1.0.0",
    "prettier-plugin-packagejson": "^3.0.0",
    "prettier-plugin-prisma": "^5.0.0",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.56.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "nx",
      "prisma"
    ]
  }
}
