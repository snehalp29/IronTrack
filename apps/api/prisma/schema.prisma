// ─────────────────────────────────────────────────────────────
// IronTrack — Prisma Schema
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════  ENUMS  ═══════════════════════

enum ExerciseType {
  WEIGHT_REPS
  BODYWEIGHT
  DURATION
  REPS_ONLY
  BODYWEIGHT_PLUS_WEIGHT
}

enum VideoProvider {
  YOUTUBE
  VIMEO
  OTHER
}

enum SessionStatus {
  IN_PROGRESS
  FINISHED
}

enum EndedReason {
  USER_ENDED
  AUTO_TIMEOUT
}

enum PrType {
  MAX_WEIGHT
  MAX_VOLUME
  MAX_REPS
  MAX_1RM_EST
}

enum StreakType {
  WORKOUT
  CHECKLIST
}

enum ChecklistType {
  WORKOUT
  WARMUP
  MOBILITY
  NOTES
}

enum UnitPreference {
  METRIC
  IMPERIAL
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

// ═══════════════════════  MODELS  ═══════════════════════

// ─── User ───────────────────────────────────────────────

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique @db.VarChar(320)
  passwordHash   String
  name           String?
  avatarUrl      String?
  timezone       String?        @default("UTC")
  unitPreference UnitPreference @default(METRIC)
  authProvider   AuthProvider   @default(LOCAL)
  googleId       String?        @unique
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  // Relations
  exercises        ExerciseTemplate[]
  workoutTemplates WorkoutTemplate[]
  workoutSessions  WorkoutSession[]
  exerciseNotes    ExerciseNote[]
  prRecords        PRRecord[]
  streaks          UserStreak[]
  checklistItems   ChecklistItem[]
  refreshTokens    RefreshToken[]
}

// ─── RefreshToken (D7 — DB-stored refresh tokens) ──────

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
}

// ─── Catalog: MuscleGroup ──────────────────────────────

model MuscleGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  imageUrl  String?
  iconUrl   String?
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  primaryExercises   ExerciseTemplate[]
  secondaryExercises ExerciseTemplateSecondaryMuscle[]
}

// ─── Catalog: Equipment ────────────────────────────────

model Equipment {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  iconUrl   String?
  sortOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  exercises ExerciseTemplateEquipment[]
}

// ─── ExerciseTemplate ──────────────────────────────────

model ExerciseTemplate {
  id                   String       @id @default(uuid()) @db.Uuid
  name                 String       @db.VarChar(120)
  description          String?      @db.Text
  exerciseType         ExerciseType
  isGlobal             Boolean      @default(false)
  ownerUserId          String?      @db.Uuid
  primaryMuscleGroupId String       @db.Uuid
  defaultSets          Int?
  repMin               Int?
  repMax               Int?
  defaultCues          String?      @db.Text
  deletedAt            DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  owner            User?                             @relation(fields: [ownerUserId], references: [id])
  primaryMuscle    MuscleGroup                       @relation(fields: [primaryMuscleGroupId], references: [id])
  secondaryMuscles ExerciseTemplateSecondaryMuscle[]
  equipment        ExerciseTemplateEquipment[]
  videos           ExerciseVideo[]
  templateLinks    WorkoutTemplateExercise[]
  sessionExercises SessionExercise[]
  notes            ExerciseNote[]
  prRecords        PRRecord[]

  // Indexes: raw SQL expression indexes enforce active lower(name) uniqueness
  // for global exercises and separately per owner (D12 migration).
  @@index([ownerUserId])
  @@index([primaryMuscleGroupId])
  @@index([exerciseType])
}

// ─── Join: ExerciseTemplate ↔ MuscleGroup (secondary) ──

model ExerciseTemplateSecondaryMuscle {
  exerciseTemplateId String @db.Uuid
  muscleGroupId      String @db.Uuid

  exercise    ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)
  muscleGroup MuscleGroup      @relation(fields: [muscleGroupId], references: [id])

  @@id([exerciseTemplateId, muscleGroupId])
}

// ─── Join: ExerciseTemplate ↔ Equipment ────────────────

model ExerciseTemplateEquipment {
  exerciseTemplateId String @db.Uuid
  equipmentId        String @db.Uuid

  exercise  ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)
  equipment Equipment        @relation(fields: [equipmentId], references: [id])

  @@id([exerciseTemplateId, equipmentId])
}

// ─── ExerciseVideo ─────────────────────────────────────

model ExerciseVideo {
  id                 String        @id @default(uuid()) @db.Uuid
  exerciseTemplateId String        @db.Uuid
  provider           VideoProvider
  url                String
  title              String?
  thumbnailUrl       String?
  isPrimary          Boolean       @default(false)
  sortOrder          Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  exercise ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id], onDelete: Cascade)

  @@unique([exerciseTemplateId, sortOrder])
}

// ─── WorkoutTemplate ───────────────────────────────────

model WorkoutTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  name        String    @db.VarChar(120)
  description String?   @db.Text
  orderIndex  Int?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User                      @relation(fields: [userId], references: [id])
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]

  @@index([userId])
}

// ─── WorkoutTemplateExercise (join w/ extra fields) ────

model WorkoutTemplateExercise {
  id                 String   @id @default(uuid()) @db.Uuid
  workoutTemplateId  String   @db.Uuid
  exerciseTemplateId String   @db.Uuid
  orderIndex         Int
  defaultSets        Int?
  repMin             Int?
  repMax             Int?
  supersetGroupKey   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  template WorkoutTemplate  @relation(fields: [workoutTemplateId], references: [id], onDelete: Cascade)
  exercise ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id])

  @@unique([workoutTemplateId, orderIndex])
  @@index([workoutTemplateId])
  @@index([exerciseTemplateId])
}

// ─── WorkoutSession ────────────────────────────────────

model WorkoutSession {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  workoutTemplateId String?       @db.Uuid
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  status            SessionStatus @default(IN_PROGRESS)
  endedReason       EndedReason?
  notes             String?       @db.VarChar(4000)
  totalVolume       Float?
  durationSeconds   Int?
  version           Int           @default(1)
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user             User              @relation(fields: [userId], references: [id])
  workoutTemplate  WorkoutTemplate?  @relation(fields: [workoutTemplateId], references: [id])
  sessionExercises SessionExercise[]
  sessionNotes     SessionNote[]
  prRecords        PRRecord[]

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([userId, workoutTemplateId])
}

// ─── SessionExercise ───────────────────────────────────

model SessionExercise {
  id                 String    @id @default(uuid()) @db.Uuid
  sessionId          String    @db.Uuid
  exerciseTemplateId String    @db.Uuid
  orderIndex         Int
  supersetGroupKey   String?
  notes              String?   @db.Text
  version            Int       @default(1)
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  session  WorkoutSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id])
  sets     Set[]

  @@unique([sessionId, orderIndex])
  @@index([sessionId])
}

// ─── Set ───────────────────────────────────────────────

model Set {
  id                String       @id @default(uuid()) @db.Uuid
  sessionExerciseId String       @db.Uuid
  orderIndex        Int
  type              ExerciseType
  payload           Json
  isCompleted       Boolean      @default(false)
  completedAt       DateTime?
  idempotencyKey    String?

  // Denormalized columns for SQL aggregation (D3)
  weight          Float?
  reps            Int?
  durationSeconds Int?
  rpe             Float?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessionExercise SessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  prRecords       PRRecord[]

  @@unique([sessionExerciseId, orderIndex])
  @@unique([sessionExerciseId, idempotencyKey])
  @@index([sessionExerciseId])
}

// ─── ExerciseNote ──────────────────────────────────────

model ExerciseNote {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  exerciseTemplateId String   @db.Uuid
  note               String   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id])
  exercise ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id])

  @@unique([userId, exerciseTemplateId])
  @@index([userId])
}

// ─── SessionNote ───────────────────────────────────────

model SessionNote {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  note      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  session WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// ─── PRRecord ──────────────────────────────────────────

model PRRecord {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @db.Uuid
  exerciseTemplateId String   @db.Uuid
  prType             PrType
  value              Float
  achievedAt         DateTime @default(now())

  // Provenance tracking
  setId     String? @db.Uuid
  sessionId String? @db.Uuid

  user     User             @relation(fields: [userId], references: [id])
  exercise ExerciseTemplate @relation(fields: [exerciseTemplateId], references: [id])
  set      Set?             @relation(fields: [setId], references: [id], onDelete: SetNull)
  session  WorkoutSession?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([userId, exerciseTemplateId, prType])
  @@index([userId, exerciseTemplateId])
}

// ─── UserStreak ────────────────────────────────────────

model UserStreak {
  id                String     @id @default(uuid()) @db.Uuid
  userId            String     @db.Uuid
  streakType        StreakType
  currentStreakDays Int        @default(0)
  longestStreakDays Int        @default(0)
  lastCompletedDate DateTime?  @db.Date

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, streakType])
  @@index([userId])
}

// ─── ChecklistItem ─────────────────────────────────────

model ChecklistItem {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  date        DateTime      @db.Date
  type        ChecklistType
  isCompleted Boolean       @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date, type])
  @@index([userId, date])
}
